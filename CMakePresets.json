{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "description": "Debug build with unit tests enabled.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BINLOG_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-bench",
      "inherits": "release",
      "cacheVariables": {
        "BINLOG_BUILD_BENCH": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "perf",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "codspeed",
      "description": "Benchmarks instrumented for CodSpeed (CPU simulation). Uses the default generator and compiler so it also works in CI.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "BINLOG_BUILD_APPS": "OFF",
        "BINLOG_BUILD_TESTS": "OFF",
        "BINLOG_BUILD_BENCH": "ON",
        "CODSPEED_MODE": "simulation"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug","configurePreset": "debug"},
    {"name": "release","configurePreset": "release"},
    {"name": "release-bench","configurePreset": "release-bench"},
    {"name": "perf","configurePreset": "perf"},
    {"name": "codspeed","configurePreset": "codspeed"}
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
